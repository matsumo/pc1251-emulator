C168 39 15     ; JRZM SERVE
C16A 02 02     ; LIA 02
C16C 03 28     ; LIB 28
C16E 78 C4 FE  ; CALL C4FE  (TONE)
; ---- 遊んでいるあいだの1フレーム ----
C171 78 C2 2C  ; CALL C22C  (KEYS)  PLAY:
C174 97        ; LP 17              壁を寄せる
C175 70 01     ; ADIM 01
C177 59        ; LDM
C178 AD        ; LP 2D              (ADVR)-(ADVT)が正ならまだ
C179 C7        ; CPMA
C17A 38 03     ; JRZP PL_ADV0
