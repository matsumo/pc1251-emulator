C28C 94        ; LP 14
C28D 70 01     ; ADIM 01
C28F 37        ; RTN                K_END:
; ---- SPACEかENTERが押されていればZでない ----
C290 02 30     ; LIA 30             FIRE: SPACEはIAのビット4、ENTERはビット5。読むとビット7
C292 12 5C     ; LIP 5C  (KEYPA)
C294 DB        ; EXAM
C295 5D        ; OUTA
C296 4E 0A     ; WAIT 0A
C298 4C        ; INA
C299 34        ; PUSH
C29A 23        ; CLRA
C29B 12 5C     ; LIP 5C  (KEYPA)
C29D DB        ; EXAM
C29E 5D        ; OUTA
C29F 5B        ; POP
C2A0 64 80     ; ANIA 80
C2A2 37        ; RTN
; ---- 玉をパドルの右に置く ----
C2A3 02 03     ; LIA 03
C2A5 90        ; LP 10
C2A6 DB        ; EXAM
C2A7 02 01     ; LIA 01
C2A9 92        ; LP 12
C2AA DB        ; EXAM
C2AB 02 06     ; LIA 06
C2AD 93        ; LP 13
C2AE DB        ; EXAM
C2AF 94        ; LP 14              y = PAD*32+48(2段のまんなか)。3段なら+16で真ん中の段
C2B0 59        ; LDM
C2B1 58        ; SWP
C2B2 D1        ; RC
C2B3 5A        ; SL
C2B4 74 30     ; ADIA 30
C2B6 91        ; LP 11
C2B7 DB        ; EXAM
