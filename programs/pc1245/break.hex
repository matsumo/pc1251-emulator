C187 67 0A     ; CPIA 0A  (DANGER)
C189 7F C1 C7  ; JPC C1C7  (CRUSH)
C18C 9A        ; LP 1A              今回の歩数 = (端数+速さ)/4
C18D 59        ; LDM
C18E 9B        ; LP 1B
C18F 44        ; ADM
C190 59        ; LDM
C191 D1        ; RC
C192 D2        ; SR
C193 D1        ; RC
C194 D2        ; SR
C195 AB        ; LP 2B
C196 DB        ; EXAM
C197 9B        ; LP 1B
C198 60 03     ; ANIM 03
C19A AB        ; LP 2B              PL_STEP:
C19B 71 01     ; SBIM 01
C19D 3A 12     ; JRCP PL_DRAW
C19F 78 C2 E2  ; CALL C2E2  (STEP)
C1A2 67 01     ; CPIA 01
C1A4 7E C1 BE  ; JPZ C1BE  (LOST)
C1A7 9C        ; LP 1C
C1A8 59        ; LDM
C1A9 67 00     ; CPIA 00
C1AB 7E C1 E3  ; JPZ C1E3  (CLEAR)
C1AE 2D 15     ; JRM PL_STEP
C1B0 78 C4 17  ; CALL C417  (DRAW)  PL_DRAW:
C1B3 78 C4 E8  ; CALL C4E8  (DELAY)
C1B6 6B 08     ; TEST 08
C1B8 7C C2 1A  ; JPNZ C21A  (QUIT)
C1BB 79 C1 71  ; JP C171  (PLAY)
; ---- 玉を落とした、押し切られた、面をクリアした ----
C1BE 02 1E     ; LIA 1E             LOST:
C1C0 03 32     ; LIB 32
C1C2 78 C4 FE  ; CALL C4FE  (TONE)
C1C5 2C 0C     ; JRP MISS
C1C7 02 28     ; LIA 28             CRUSH:
C1C9 03 3C     ; LIB 3C
