C18E DB        ; EXAM
C18F 9E        ; LP 1E
C190 59        ; LDM
C191 64 01     ; ANIA 01
C193 28 2D     ; JRNZP K_END
C195 94        ; LP 14
C196 59        ; LDM
C197 67 00     ; CPIA 00
C199 38 27     ; JRZP K_END
C19B 71 01     ; SBIM 01
C19D 37        ; RTN
C19E AC        ; LP 2C              K_DOWN:
C19F 59        ; LDM
C1A0 67 00     ; CPIA 00
C1A2 38 1E     ; JRZP K_END
C1A4 02 01     ; LIA 01
C1A6 9D        ; LP 1D
C1A7 DB        ; EXAM
C1A8 9E        ; LP 1E
C1A9 59        ; LDM
C1AA 64 01     ; ANIA 01
C1AC 28 14     ; JRNZP K_END
C1AE 02 07     ; LIA 07             下の限り = 7-PADH
C1B0 9F        ; LP 1F
C1B1 DB        ; EXAM
C1B2 95        ; LP 15
C1B3 59        ; LDM
C1B4 9F        ; LP 1F
C1B5 45        ; SBM
C1B6 94        ; LP 14
C1B7 59        ; LDM
C1B8 9F        ; LP 1F
C1B9 C7        ; CPMA               (TMP)-PAD。0以下なら動かさない
C1BA 38 06     ; JRZP K_END
C1BC 3A 04     ; JRCP K_END
C1BE 94        ; LP 14
C1BF 70 01     ; ADIM 01
C1C1 37        ; RTN                K_END:
; ---- SPACEかENTERが押されていればZでない ----
C1C2 02 30     ; LIA 30             FIRE: SPACEはIAのビット4、ENTERはビット5。読むとビット7
C1C4 12 5C     ; LIP 5C  (KEYPA)
C1C6 DB        ; EXAM
C1C7 5D        ; OUTA
C1C8 4E 0A     ; WAIT 0A
C1CA 4C        ; INA
C1CB 34        ; PUSH
C1CC 23        ; CLRA
C1CD 12 5C     ; LIP 5C  (KEYPA)
C1CF DB        ; EXAM
C1D0 5D        ; OUTA
C1D1 5B        ; POP
C1D2 64 80     ; ANIA 80
C1D4 37        ; RTN
