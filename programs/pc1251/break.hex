# title: ブロック崩し(マシン語)
# 横向きのブロック崩し。↑↓でパドル、SPACEかENTERで打ち出す。BRK(Esc)でやめる。
# 同じフォルダのbreak.basがCALL &C000で呼ぶ。アセンブラで作ったもので、「;」のあとがニーモニック。
; ---------------------------------------------------------------------
; MODELが1251ならPC-1251用、1245ならPC-1245用に組む。
; PC-1251の画面は横120列×縦7ドット。左の90列が遊ぶ場所、右の30列に残りの玉と得点。
; PC-1245は80列なので、遊ぶ場所を75列、右の5列を残りの玉にして、得点は出さない。
; 左端のパドルで玉を打ち返し、右のブロックの壁を削る。壁と右端のあいだは
; 空いているので、そこへ回り込ませると壁を裏から削れる。壁はゆっくり左へ
; 寄ってきて、先端が12列目まで来ると押し切られて玉を1個失う。
; PC-1251版は、面ごとに1つ点滅するブロックがあり、これを壊すと玉が2個になる。
; 玉は2個までで、両方落とすと1個失う。
; 玉のyは1/32ドット単位で持つ(32〜224が0〜6段目)。1列進むごとにyが4〜8変わる。xは1歩に1列ずつ進め、
; 1フレームに2〜3歩。1歩ごとに横、縦の順に動かし、ブロックに当たった
; 向きで跳ね返す。ブロックは1列6本で、1本を7ビット(縦7段)の1バイトで持つ。
; 内部RAMの10h〜2Fhを変数に使う。入るときにBASICの値をSAVEへ退避し、
; 出るときに入れ替えて戻す。そのためゲームが終わるとSAVEに変数が残り、
; 得点(5桁、1桁1バイト)はC5F6〜C5FA番地からBASICのPEEKで読める。
; PC-1251版の2個目の玉はBALL2の4バイトに置き、動かすときと描くときだけBX〜VYと入れ替える。
; ---------------------------------------------------------------------
; ---- 入り口 ----
C000 90        ; LP 10              START: BASICの内部RAMを退避
C001 00 1F     ; LII 1F
C003 10 C5 E0  ; LIDP C5E0  (SAVE)
C006 19        ; EXWD
C007 02 03     ; LIA 03
C009 98        ; LP 18
C00A DB        ; EXAM
C00B 23        ; CLRA
C00C 99        ; LP 19
C00D DB        ; EXAM
C00E 02 02     ; LIA 02             normal: パドル2段、1フレームに2歩、壁は40フレームで1列
C010 95        ; LP 15
C011 DB        ; EXAM
C012 02 08     ; LIA 08
C014 9A        ; LP 1A
C015 DB        ; EXAM
C016 02 28     ; LIA 28  (ADVN)
C018 AD        ; LP 2D
C019 DB        ; EXAM
C01A 10 C5 DF  ; LIDP C5DF  (LEVELSEL)
C01D 57        ; LDD
C01E 67 01     ; CPIA 01
C020 28 0D     ; JRNZP ST_NORM
C022 02 03     ; LIA 03             easy: パドル3段、1フレームに1.5歩、壁は60フレームで1列
C024 95        ; LP 15
C025 DB        ; EXAM
C026 02 06     ; LIA 06
C028 9A        ; LP 1A
C029 DB        ; EXAM
C02A 02 3C     ; LIA 3C  (ADVE)
C02C AD        ; LP 2D
C02D DB        ; EXAM
C02E 23        ; CLRA               ST_NORM:
C02F 9B        ; LP 1B
C030 DB        ; EXAM
C031 23        ; CLRA
C032 9E        ; LP 1E
C033 DB        ; EXAM
C034 23        ; CLRA
C035 A6        ; LP 26              得点を0に
C036 00 04     ; LII 04
C038 1E        ; FILM
C039 02 02     ; LIA 02
C03B 94        ; LP 14
C03C DB        ; EXAM
C03D 02 01     ; LIA 01             液晶の表示をつけたままにする
C03F 12 5F     ; LIP 5F  (PORTC)
C041 DB        ; EXAM
C042 DF        ; OUTC
C043 A0        ; LP 20              NEWWALL: 6本ぜんぶ7段そろえる
C044 02 7F     ; LIA 7F
C046 00 05     ; LII 05
C048 1E        ; FILM
C049 02 2A     ; LIA 2A
C04B 9C        ; LP 1C
C04C DB        ; EXAM
C04D 99        ; LP 19              点滅するブロックの場所は面ごとに表から
C04E 59        ; LDM
C04F D1        ; RC
C050 5A        ; SL
C051 74 3E     ; ADIA 3E  (lo(SPTAB-1))
C053 84        ; LP 04
C054 DB        ; EXAM
C055 02 C5     ; LIA C5  (hi(SPTAB))
C057 85        ; LP 05
C058 DB        ; EXAM
C059 24        ; IXL
C05A AE        ; LP 2E
C05B DB        ; EXAM
C05C 24        ; IXL
C05D AF        ; LP 2F
C05E DB        ; EXAM
C05F 02 32     ; LIA 32  (WALL0)    RSTWALL:
C061 96        ; LP 16
C062 DB        ; EXAM
C063 23        ; CLRA
C064 97        ; LP 17
C065 DB        ; EXAM
; ---- パドルに玉を乗せて、打ち出すのを待つ ----
C066 78 C1 5E  ; CALL C15E  (KEYS)  SERVE:
C069 78 C1 D5  ; CALL C1D5  (SETBALL)
C06C 78 C3 5A  ; CALL C35A  (DRAW)
C06F 78 C4 6F  ; CALL C46F  (DELAY)
C072 6B 08     ; TEST 08            BRK
C074 7C C1 4C  ; JPNZ C14C  (QUIT)
C077 78 C1 C2  ; CALL C1C2  (FIRE)
C07A 39 15     ; JRZM SERVE
C07C 02 02     ; LIA 02
C07E 03 28     ; LIB 28
C080 78 C4 8F  ; CALL C48F  (TONE)
; ---- 遊んでいるあいだの1フレーム ----
C083 78 C1 5E  ; CALL C15E  (KEYS)  PLAY:
C086 97        ; LP 17              壁を寄せる
C087 70 01     ; ADIM 01
C089 59        ; LDM
C08A AD        ; LP 2D              (ADVR)-(ADVT)が正ならまだ
C08B C7        ; CPMA
C08C 38 03     ; JRZP PL_ADV0
C08E 2A 07     ; JRNCP PL_ADV
C090 97        ; LP 17              PL_ADV0:
C091 23        ; CLRA
C092 DB        ; EXAM
C093 96        ; LP 16
C094 71 01     ; SBIM 01
C096 78 C1 F7  ; CALL C1F7  (FRONT) PL_ADV: 押し切られたか
C099 67 0C     ; CPIA 0C  (DANGER)
C09B 7F C0 F3  ; JPC C0F3  (CRUSH)
C09E 9A        ; LP 1A              今回の歩数 = (端数+速さ)/4
C09F 59        ; LDM
C0A0 9B        ; LP 1B
C0A1 44        ; ADM
C0A2 59        ; LDM
C0A3 D1        ; RC
C0A4 D2        ; SR
C0A5 D1        ; RC
C0A6 D2        ; SR
C0A7 AB        ; LP 2B
C0A8 DB        ; EXAM
C0A9 9B        ; LP 1B
C0AA 60 03     ; ANIM 03
C0AC AB        ; LP 2B              PL_STEP:
C0AD 71 01     ; SBIM 01
C0AF 3A 2C     ; JRCP PL_DRAW
C0B1 78 C2 17  ; CALL C217  (STEP)
C0B4 67 01     ; CPIA 01
C0B6 28 0B     ; JRNZP PL_B2
C0B8 78 C4 B1  ; CALL C4B1  (SWAP2) 1個目を落としたら2個目を1個目にする
C0BB 90        ; LP 10
C0BC 59        ; LDM
C0BD 67 FF     ; CPIA FF
C0BF 7E C0 EA  ; JPZ C0EA  (LOST)
C0C2 10 BF 84  ; LIDP BF84  (BALL2) PL_B2:
C0C5 57        ; LDD
C0C6 67 FF     ; CPIA FF
C0C8 38 0A     ; JRZP PL_LEFT
C0CA 78 C4 B1  ; CALL C4B1  (SWAP2) 2個目を進める。落としても戻せばBXがFFで、いないことになる
C0CD 78 C2 17  ; CALL C217  (STEP)
C0D0 78 C4 B1  ; CALL C4B1  (SWAP2)
C0D3 9C        ; LP 1C
C0D4 59        ; LDM
C0D5 67 00     ; CPIA 00
C0D7 7E C1 12  ; JPZ C112  (CLEAR)
C0DA 2D 2F     ; JRM PL_STEP
C0DC 78 C3 5A  ; CALL C35A  (DRAW)  PL_DRAW:
C0DF 78 C4 6F  ; CALL C46F  (DELAY)
C0E2 6B 08     ; TEST 08
C0E4 7C C1 4C  ; JPNZ C14C  (QUIT)
C0E7 79 C0 83  ; JP C083  (PLAY)
; ---- 玉を落とした、押し切られた、面をクリアした ----
C0EA 02 1E     ; LIA 1E             LOST:
C0EC 03 32     ; LIB 32
C0EE 78 C4 8F  ; CALL C48F  (TONE)
C0F1 2C 0C     ; JRP MISS
