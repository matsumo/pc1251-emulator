C144 02 0C     ; LIA 0C
C146 78 C4 81  ; CALL C481  (PAUSE)
C149 79 C0 43  ; JP C043  (NEWWALL)
C14C 90        ; LP 10              QUIT: 内部RAMをBASICの値に戻す(変数はSAVEに残る)
C14D 00 1F     ; LII 1F
C14F 10 C5 E0  ; LIDP C5E0  (SAVE)
C152 19        ; EXWD
C153 23        ; CLRA
