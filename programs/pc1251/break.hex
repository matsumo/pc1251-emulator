C107 78 C4 81  ; CALL C481  (PAUSE)
C10A 98        ; LP 18
C10B 71 01     ; SBIM 01
C10D 38 3E     ; JRZP QUIT
C10F 79 C0 66  ; JP C066  (SERVE)
C112 02 05     ; LIA 05             CLEAR: 500点
C114 A8        ; LP 28
